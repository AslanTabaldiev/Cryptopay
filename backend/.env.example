# Скопируйте в .env и заполните. Никогда не коммитьте .env.

# Кошелёк продавца (публичный адрес из MetaMask) — сюда приходят платежи
MERCHANT_ADDRESS=0x0000000000000000000000000000000000000000
# API-ключ магазина (по умолчанию cryptopay-demo-key). В учебном проекте он показан на сайте.
MERCHANT_API_KEY=
# Включена ли проверка ключа при старте сервера. Меняется переключателем в кабинете.
API_KEY_REQUIRED=false

# JSON-RPC сети Sepolia (по умолчанию публичная нода, можно URL Alchemy/Infura)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
NETWORK_NAME=Sepolia
EXPLORER_URL=https://sepolia.etherscan.io
REQUIRED_CONFIRMATIONS=2

# Локально SQLite; на Render подставляется URL PostgreSQL автоматически
DATABASE_URL=sqlite:///./cryptopay.db

# Источники, разрешённые CORS (нужно только для npm run dev), через запятую
CORS_ORIGINS=http://localhost:5173

# Куда слать вебхуки. Пусто = во встроенный демо-магазин «Кофейня» (/api/shop/webhook)
WEBHOOK_URL=
WEBHOOK_SECRET=change-me-too

# Уведомления продавцу в Telegram (необязательно, см. README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DEFAULT_TTL_MINUTES=15
TX_NOT_FOUND_TIMEOUT_MINUTES=10
POLL_INTERVAL_SECONDS=5
